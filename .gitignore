# Node / build artifacts
node_modules/
dist/
.vite/
*.tsbuildinfo

# Test / coverage output
coverage/
.nyc_output/
test-results/

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pid
.tmp/

# Environment & secrets
.env
.env.*
!.env.example

# Editor / IDE
.vscode/
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Podman / Docker local state
.podman/
.docker/

# User's local rsyslog configs. The repo ships a self-contained demo under
# conf-demo/; whatever you mount into ./conf at runtime is your own.
/conf/*
!/conf/.gitkeep

# Never accidentally exclude the demo configs.
!conf-demo/
!conf-broken/

# Screenshot / browser caches left over from dev sessions.
.playwright-mcp/
/*.png

# Local test artifacts.
test-replay-corpus.log
.test.mjs
